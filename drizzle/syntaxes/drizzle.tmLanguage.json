{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "drizzle",
  "scopeName": "source.zz",
  "fileTypes": ["zz", "rd", "drizzle"],
  "patterns": [
    {
      "name": "comment.line.zz",
      "match": "^\\s*&&.*$"
    },
    {
      "match": "^\\s*([A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)*(?:\\s*,\\s*[A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)*)*)\\s*(<?(?:--|__)>?)\\s*([A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)*)\\s*((?:\\[(?:o|\\*|zigzag|bar|ortho)\\]\\s*)*)(?:(via)\\s+(right|left|top|bottom)\\s*)?(?:(:)(.*))?$",
      "captures": {
        "1": { "name": "variable.other.zz" },
        "2": { "name": "keyword.operator.connection.zz" },
        "3": { "name": "variable.other.zz" },
        "4": { "name": "constant.language.marker.zz" },
        "5": { "name": "keyword.control.zz" },
        "6": { "name": "constant.language.side.zz" },
        "7": { "name": "punctuation.separator.zz" },
        "8": { "name": "string.unquoted.label.zz", "patterns": [{ "include": "#escape" }] }
      }
    },
    {
      "match": "^\\s*(layout)\\s+(right|left|up|down)\\s*$",
      "captures": {
        "1": { "name": "keyword.control.zz" },
        "2": { "name": "constant.language.direction.zz" }
      }
    },
    {
      "match": "^\\s*([A-Za-z][A-Za-z0-9]*(?:_[A-Za-z0-9]+)*)\\s*(@\\s*\\d+\\s*,\\s*\\d+\\s*)?(=)",
      "captures": {
        "1": { "name": "variable.other.zz" },
        "2": { "name": "constant.numeric.grid.zz" },
        "3": { "name": "keyword.operator.assignment.zz" }
      }
    },
    { "name": "storage.modifier.bold.zz", "match": "!(?=\\s*(?:/|<|\\[|\\(|\\{|\\\\|~|\\^))" },
    { "include": "#shapes" }
  ],
  "repository": {
    "escape": {
      "name": "constant.character.escape.zz",
      "match": "\\\\(?:n|\\\\|/|>|\\]|\\)|\\}|\\^|~)"
    },
    "shapes": {
      "patterns": [
        { "name": "string.unquoted.goal.zz", "begin": "/", "end": "/|$", "patterns": [{ "include": "#escape" }] },
        { "name": "string.unquoted.risk.zz", "begin": "\\\\", "end": "\\\\|$", "applyEndPatternLast": true, "patterns": [{ "include": "#escape" }] },
        { "name": "string.unquoted.agent.zz", "begin": "<", "end": ">|$", "patterns": [{ "include": "#escape" }] },
        { "name": "string.unquoted.object.zz", "begin": "\\[", "end": "\\]|$", "patterns": [{ "include": "#escape" }] },
        { "name": "string.unquoted.action.zz", "begin": "\\(", "end": "\\)|$", "patterns": [{ "include": "#escape" }] },
        { "name": "string.unquoted.cloud.zz", "begin": "\\{\\{", "end": "\\}\\}|$", "patterns": [{ "include": "#escape" }] },
        { "name": "string.unquoted.note.zz", "begin": "\\{", "end": "\\}|$", "patterns": [{ "include": "#escape" }] },
        { "name": "string.unquoted.diamond.zz", "begin": "\\^", "end": "\\^|$", "patterns": [{ "include": "#escape" }] },
        { "name": "string.unquoted.descriptive.zz", "begin": "~", "end": "~|$", "patterns": [{ "include": "#escape" }] }
      ]
    }
  }
}
