WHITESPACE = _{ " " | "\t" }
identifier = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_" ~ ASCII_ALPHANUMERIC)* }
number     = @{ ASCII_DIGIT+ }
position   = { "@" ~ number ~ "," ~ number }
escape     = _{ "\\" ~ ("n" | "\\" | "/" | ">" | "]" | ")" | "}" | "^" | "~") }
goal       = @{ "/"  ~ (escape | !("/"  | "\\") ~ ANY)* ~ "/" }
risk       = @{ "\\" ~ (escape | !"\\"         ~ ANY)* ~ "\\" }
agent      = @{ "<"  ~ (escape | !(">"  | "\\") ~ ANY)* ~ ">" }
object     = @{ "["  ~ (escape | !("]"  | "\\") ~ ANY)* ~ "]" }
action     = @{ "("  ~ (escape | !(")"  | "\\") ~ ANY)* ~ ")" }
note       = @{ "{"  ~ (escape | !("}"  | "\\") ~ ANY)* ~ "}" }
cloud      = @{ "{{" ~ (escape | !("}}" | "\\") ~ ANY)* ~ "}}" }
diamond    = @{ "^"  ~ (escape | !("^"  | "\\") ~ ANY)* ~ "^" }
descriptive = @{ "~" ~ (escape | !("~" | "\\") ~ ANY)* ~ "~" }
shape      = _{ goal | risk | agent | object | action | cloud | note | diamond | descriptive }
bold       = { "!" }
node       = { bold? ~ shape }
named      = { identifier ~ position? ~ "=" ~ node }
anonymous  = { node+ }
operator   = @{ "<"? ~ ("--" | "__") ~ ">"? }
direction  = @{ "right" | "left" | "up" | "down" }
layout     = ${ "layout" ~ (" " | "\t")+ ~ direction }
modifier   = @{ "[o]" | "[*]" | "[zigzag]" | "[bar]" | "[ortho]" }
side       = @{ "right" | "left" | "top" | "bottom" }
via        = ${ "via" ~ (" " | "\t")+ ~ side }
edge_label = @{ ":" ~ (escape | !"\\" ~ ANY)* }
sources    = { identifier ~ ("," ~ identifier)* }
edge       = { sources ~ operator ~ identifier ~ modifier* ~ via? ~ edge_label? }
line       = { SOI ~ (layout | named | edge | anonymous) ~ EOI }
